#!/bin/bash
# ═══════════════════════════════════════════════════════
#  BLACK GOD LINUX — System Update Tool
#  Usage: blackgod-update
# ═══════════════════════════════════════════════════════

RED='\033[1;31m'
GOLD='\033[1;33m'
GREEN='\033[1;32m'
WHITE='\033[1;37m'
DIM='\033[2m'
RESET='\033[0m'

echo ""
echo -e "${RED}  ╔══════════════════════════════════════════════╗${RESET}"
echo -e "${RED}  ║${GOLD}   ⚡ BLACK GOD — SYSTEM UPDATER ⚡             ${RED}║${RESET}"
echo -e "${RED}  ╚══════════════════════════════════════════════╝${RESET}"
echo ""

# Check for root
if [ "$EUID" -ne 0 ]; then
    echo -e "${RED}[✗]${RESET} This script must be run as root."
    echo -e "${DIM}    Run: sudo blackgod-update${RESET}"
    exit 1
fi

echo -e "${GREEN}[1/4]${RESET} ${WHITE}Updating package lists...${RESET}"
apt update 2>&1 | tail -3

echo -e "\n${GREEN}[2/4]${RESET} ${WHITE}Upgrading installed packages...${RESET}"
apt full-upgrade -y 2>&1 | tail -5

echo -e "\n${GREEN}[3/4]${RESET} ${WHITE}Removing orphaned packages...${RESET}"
apt autoremove -y 2>&1 | tail -3

echo -e "\n${GREEN}[4/4]${RESET} ${WHITE}Cleaning package cache...${RESET}"
apt autoclean -y 2>&1 | tail -2

# Update Metasploit DB if available
if command -v msfdb &> /dev/null; then
    echo -e "\n${GOLD}[+]${RESET} ${WHITE}Refreshing Metasploit database...${RESET}"
    msfdb reinit 2>&1 | tail -3
fi

# Update SearchSploit if available
if command -v searchsploit &> /dev/null; then
    echo -e "\n${GOLD}[+]${RESET} ${WHITE}Updating ExploitDB...${RESET}"
    searchsploit -u 2>&1 | tail -3
fi

echo ""
echo -e "${DIM}────────────────────────────────────────────────${RESET}"
echo -e "${GREEN}[✓]${RESET} ${WHITE}Black God Linux is fully updated!${RESET}"
echo -e "${DIM}    Last updated: $(date)${RESET}"
echo ""
