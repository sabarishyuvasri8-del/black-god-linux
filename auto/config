#!/bin/bash
# ═══════════════════════════════════════════════════════
#  BLACK GOD LINUX — live-build auto/config
#  Supports both AMD64 (PC) and ARM64 (Apple Silicon)
# ═══════════════════════════════════════════════════════

set -e

KALI_MIRROR="http://http.kali.org/kali"
DIST="kali-rolling"
ARCH=$(dpkg --print-architecture)

# Detect architecture from args if specified
while [ $# -gt 0 ]; do
    case "$1" in
        -a|--arch|--architecture|--architectures)
            ARCH="$2"
            shift 2
            ;;
        *)
            shift
            ;;
    esac
done

# Ensure debian-cd symlink exists for kali-rolling
LB_DATA="${LIVE_BUILD:-/usr/share/live/build}/data/debian-cd"
if [ -d "$LB_DATA" ] && [ ! -e "$LB_DATA/$DIST" ]; then
    ln -sf sid "$LB_DATA/$DIST" 2>/dev/null || true
fi

# Ensure keyring is in /usr/share/keyrings
if [ ! -f /usr/share/keyrings/kali-archive-keyring.gpg ] && [ -f /etc/apt/trusted.gpg.d/kali-archive-keyring.gpg ]; then
    mkdir -p /usr/share/keyrings
    cp /etc/apt/trusted.gpg.d/kali-archive-keyring.gpg /usr/share/keyrings/kali-archive-keyring.gpg 2>/dev/null || true
fi

# Clean previous configs
rm -rf config/package-lists config/includes.chroot
mkdir -p config

# Copy custom configurations and package lists
if [ -d "kali-config/common" ]; then
    cp -r kali-config/common/* config/
fi

if [ -d "kali-config/variant-default" ]; then
    cp -r kali-config/variant-default/* config/
fi

# Architecture-specific options
LB_ARCH_OPTS=""
if [ "$ARCH" = "arm64" ]; then
    LB_ARCH_OPTS="--bootloaders grub-efi --uefi-secure-boot disable --linux-packages linux-image"
else
    LB_ARCH_OPTS="--linux-packages linux-image"
fi

# Run lb config with correct flags
lb config noauto \
    --distribution "$DIST" \
    --architectures "$ARCH" \
    --archive-areas "main contrib non-free non-free-firmware" \
    --mirror-bootstrap "$KALI_MIRROR" \
    --mirror-binary "$KALI_MIRROR" \
    --mirror-chroot "$KALI_MIRROR" \
    --debootstrap-options "--include=kali-archive-keyring --keyring=/usr/share/keyrings/kali-archive-keyring.gpg" \
    --keyring-packages kali-archive-keyring \
    --bootappend-live "boot=live components quiet splash noeject" \
    --bootappend-install "net.ifnames=0" \
    --binary-images iso-hybrid \
    --checksums sha256 \
    --chroot-filesystem squashfs \
    --firmware-binary true \
    --firmware-chroot true \
    --iso-application "Black God Linux" \
    --iso-publisher "Black God Linux Project" \
    --iso-volume "BLACKGOD" \
    --memtest none \
    --updates false \
    --security false \
    --backports false \
    --apt-indices false \
    --source false \
    $LB_ARCH_OPTS \
    "${@}"
